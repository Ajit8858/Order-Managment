# --- App ---
PROJECT_NAME="Order Management Backend"
ENV=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://omb_user:omb_pass@localhost:5432/order_management
SYNC_DATABASE_URL=postgresql+psycopg2://omb_user:omb_pass@localhost:5432/order_management

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Email (simulated / SMTP) ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=orders@example.com

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
